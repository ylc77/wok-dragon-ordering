SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-publishable-key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Optional. Leave empty to use the Windows default printer.
PRINTER_NAME=

# 58 or 80
PAPER_WIDTH=80

# Polling interval for new orders.
POLL_INTERVAL_MS=3000

# true prints automatically; false only logs pending orders.
AUTO_PRINT=true

# Max pending orders to print in each polling cycle.
MAX_ORDERS_PER_POLL=10
